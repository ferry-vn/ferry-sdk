{
  "name": "@ferryvn/sdk",
  "version": "1.0.0",
  "description": "Official typed, zero-dependency TypeScript client for the FerryVN ferry-ticket partner API (Node.js, Bun, Deno, edge runtimes)",
  "license": "Apache-2.0",
  "author": "Ferry VN JSC <hi@ferry.vn> (https://ferry.vn)",
  "homepage": "https://github.com/ferry-vn/ferry-sdk/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferry-vn/ferry-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/ferry-vn/ferry-sdk/issues"
  },
  "keywords": [
    "ferryvn",
    "ferry",
    "vietnam",
    "ferry-ticket",
    "booking",
    "sdk",
    "api-client",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/sdk.json -o src/generated/partner-api.d.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
